# ------------------------------------------------------------------
# Portfolio frontend — copy to frontend/.env.local and fill in.
# Everything here is bundled into public JavaScript: put NO secrets here.
# (Firebase web config is designed to be public; security comes from
#  Firebase Auth + Firestore rules + backend authorization.)
# ------------------------------------------------------------------

# Backend base URL. Leave empty in development (Vite proxies /api to :4000).
# In production, e.g. https://portfolio-api.onrender.com
VITE_API_URL=
# Dev-only: where the Vite proxy forwards /api
VITE_DEV_API_PROXY=http://localhost:4000

# Hidden admin route (no leading slash). Changing it is obscurity, not security.
VITE_ADMIN_PATH=admin

# Firebase web app config (Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=portfolio-datbase.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=portfolio-datbase
VITE_FIREBASE_STORAGE_BUCKET=portfolio-datbase.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=529977232544
VITE_FIREBASE_APP_ID=1:529977232544:web:9abb36231459e982734dc5
VITE_FIREBASE_MEASUREMENT_ID=G-Y2JRFC97X3

# Public site URL used for canonical links and share URLs
VITE_SITE_URL=https://hassanadvani-portfolio.vercel.app
