# ------------------------------------------------------------------
# Portfolio backend — copy to backend/.env.local and fill in locally.
# .env.local is git-ignored AND never uploaded by `firebase deploy`.
# In Cloud Functions, secrets come from Firebase Secret Manager instead
# (see docs/CONTACT_AUTOMATION.md). Never commit real values.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Public URL of the frontend (used in sitemap + email links)
SITE_URL=http://localhost:5173
# "loopback" locally; "1" behind a single reverse proxy (Render/Railway/Cloud Run)
TRUST_PROXY=loopback
# Random string used to hash visitor IPs on contact messages
IP_HASH_SALT=

# ---------------- Firebase Admin SDK ----------------
# Option A: path to the downloaded service-account JSON (keep it OUTSIDE the repo or in backend/secrets/)
FIREBASE_SERVICE_ACCOUNT_PATH=
# Option B: individual fields (useful on hosting platforms)
FIREBASE_PROJECT_ID=portfolio-datbase
FIREBASE_CLIENT_EMAIL=
# Paste with literal \n sequences, wrapped in double quotes
FIREBASE_PRIVATE_KEY=

# ---------------- Cloudinary ----------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=568963161659882
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio

# ---------------- Contact email (Resend) ----------------
# Secret. https://resend.com/api-keys — use "Sending access" for production.
RESEND_API_KEY=
# Sender. onboarding@resend.dev works only for emails TO the Resend account owner, so it
# can notify Hassan but CANNOT auto-reply to visitors. After verifying a domain
# (npm run resend-domain -- add yourdomain.com), use e.g. "Hassan Advani <hello@yourdomain.com>".
RESEND_FROM=Portfolio Contact <onboarding@resend.dev>
# Where every contact submission notification is delivered
CONTACT_NOTIFY_TO=hassanadvani08@gmail.com
OWNER_NAME=Hassan Advani

# ---------------- AI automatic replies (Claude) ----------------
# Secret. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high — low is plenty for short grounded replies
AI_EFFORT=low
AI_REPLY_ENABLED=true

# ---------------- Visitor auto-reply safety limits ----------------
AUTO_REPLY_ENABLED=true
# Max automatic replies per day (protects your domain reputation from abuse)
AUTO_REPLY_DAILY_LIMIT=50
# At most one automatic reply per recipient address within this many hours
AUTO_REPLY_PER_RECIPIENT_HOURS=24

# ---------------- GitHub ----------------
GITHUB_USERNAME=Hassan123advani
# Optional fine-grained token (no scopes needed) to raise the API rate limit
GITHUB_TOKEN=
